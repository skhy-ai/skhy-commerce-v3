# ─────────────────────────────────────────────
# Supabase (required for app + build scripts)
# ─────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side only, never exposed to browser
PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_...
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

# ─────────────────────────────────────────────
# Third-party services
# ─────────────────────────────────────────────
VITE_WEB3FORMS_ACCESS_KEY=your-web3forms-key
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key    # Cloudflare Turnstile (public)
VITE_SENTRY_DSN=                                   # optional Sentry DSN

# Resend Serverless Email Variables (Netlify Backend)
# Do NOT prefix with VITE_ to keep key strictly hidden on the server
RESEND_API_KEY=your-resend-api-key

# OpenRouter AI Proxy Variables (Netlify Backend & Vite dev proxy)
# Do NOT prefix with VITE_ to keep key strictly hidden on the server
OPENROUTER_KEY=your-openrouter-key



# ─────────────────────────────────────────────
# Cloudinary CDN (used by scripts/upload_to_cdn.js)
# Free tier: https://cloudinary.com/users/register/free
# Never prefix with VITE_ — these are server/build-side only
# ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
