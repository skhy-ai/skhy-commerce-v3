    "date-fns": "^4.1.0",
    "dompurify": "^3.3.1",
    "dotenv": "^17.4.1",
    "framer-motion": "^12.33.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.1.0",
    "jspdf-autotable": "^5.0.7",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.363.0",
