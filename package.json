    "@stripe/react-stripe-js": "^5.6.0",
    "@stripe/stripe-js": "^8.7.0",
    "@supabase/supabase-js": "^2.39.7",
    "@types/d3-geo": "^3.1.0",
    "@types/html2canvas": "^0.5.35",
    "@types/leaflet": "^1.9.21",
    "@types/three": "^0.179.0",
    "@xyflow/react": "^12.10.2",
